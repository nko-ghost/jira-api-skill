# Jira Integration Skill - Example Configuration
# Copy this file to .env and fill in your details.

# === REQUIRED CONFIGURATION ===
# Your Jira instance base URL (e.g., https://your-domain.atlassian.net)
JIRA_BASE_URL=https://your-domain.atlassian.net

# For Jira Cloud: Your email address
# For Jira Data Center: Leave blank if using PAT
JIRA_USER_EMAIL=user@example.com

# For Jira Cloud: Your API Token
# For Jira Data Center: Your Personal Access Token (PAT)
JIRA_TOKEN=your_api_token_here

# === OPTIONAL CONFIGURATION (Default values shown) ===

# API version path. Default is /rest/api/2.
# JIRA_API_PATH=/rest/api/2

# Output format for the CLI. Options: json, table. Default is json.
# JIRA_OUTPUT=table

# Custom field IDs for Story Points and Epic Links if they differ from defaults.
# JIRA_STORY_POINTS_FIELD=customfield_10016
# JIRA_EPIC_LINK_FIELD=customfield_10014
